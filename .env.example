# =====================================================================
# NERO LABS — TELEGRAM AI BOT & MINI APP CONFIGURATION
# =====================================================================

# 1. Telegram Bot Credentials
# Obtain from @BotFather on Telegram (e.g., 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. Owner Authorization (CRITICAL SECURITY)
# MUST be your numeric Telegram user ID (NOT your @username).
# You can find your ID by messaging @userinfobot or @raw_data_bot on Telegram.
TELEGRAM_OWNER_ID="123456789"

# 3. ScaleMax AI Provider Configuration
# Obtain your API key from the ScaleMax Dashboard (https://dashboard.scalemax.pro)
SCALEMAX_API_KEY="your_scalemax_api_key_here"

# API Base URL:
# Use "https://api.scalemax.pro/v1" for API-Credit accounts (USD credit balance)
# Use "https://api.scalemax.pro/token/v1" for Token-Budget accounts
SCALEMAX_BASE_URL="https://api.scalemax.pro/v1"

# Default Model: GPT-6 Luna is optimized for low-latency, high-efficiency text
SCALEMAX_DEFAULT_MODEL="gpt-6-luna"

# 4. Private Dashboard & Access Key
# A unique secret key for accessing the owner dashboard outside Telegram Mini App
# NOTE: This is NOT your ScaleMax API key and NOT your bot token!
DASHBOARD_ACCESS_KEY="nero_dev_secret_key_change_me"

# 5. Application Server Settings
PORT=3001
NODE_ENV="development"
DATABASE_PATH="./data/nerolabs.db"

# Public URL for Telegram Mini App (e.g. ngrok or local network if testing from phone)
# Example: https://abc-123.ngrok-free.app
WEBAPP_PUBLIC_URL=""
